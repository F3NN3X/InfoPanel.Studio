#!/bin/sh
# Optional: git config core.hooksPath .githooks
# Refuses a push of changes that were never verified: runs `npm run verify` when the last run is stale.
node tools/verify.mjs --check-fresh >/dev/null 2>&1
case $? in
  0) exit 0 ;;
  1) echo "pre-push: the last verify failed on this tree. Fix it, or push with --no-verify." >&2; exit 1 ;;
  *) npm run verify ;;
esac
