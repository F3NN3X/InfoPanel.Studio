{
  "id": "cyberspec",
  "name": "Cyberspec",
  "version": "3.0.0",
  "tags": [
    "dark",
    "cyberpunk",
    "angular",
    "crt"
  ],
  "description": "Near-black panels cut at two corners with a hatched band, a dot grid and a caption above, in a framed screen; solid tone slabs with dark ink for warnings, current rows, tabs and chips; big cyan readouts with small decimals over a rule; 20-cell meters, hexagon gauges, signal graphs and departure-board rows; Kode Mono titles, values that roll and glitch, rows that slide in and a page that boots card by card. After Cyberspec by Agnel Nieves (MIT), github.com/agnelnieves/cyberspec.",
  "modes": [
    "dark"
  ],
  "fonts": [
    {
      "family": "pack-cyberspec",
      "source": "Rajdhani",
      "file": "rajdhani-500.woff2",
      "weight": "100 500",
      "licence": "OFL-1.1",
      "copyright": "Copyright (c) 2014 Indian Type Foundry (info@indiantypefoundry.com)"
    },
    {
      "family": "pack-cyberspec",
      "source": "Rajdhani",
      "file": "rajdhani-600.woff2",
      "weight": "600 900",
      "licence": "OFL-1.1",
      "copyright": "Copyright (c) 2014 Indian Type Foundry (info@indiantypefoundry.com)"
    },
    {
      "family": "pack-cyberspec-mono",
      "source": "JetBrains Mono",
      "file": "jetbrains-mono-400.woff2",
      "weight": "100 500",
      "licence": "OFL-1.1",
      "copyright": "Copyright 2020 The JetBrains Mono Project Authors (https://github.com/JetBrains/JetBrainsMono)"
    },
    {
      "family": "pack-cyberspec-mono",
      "source": "JetBrains Mono",
      "file": "jetbrains-mono-600.woff2",
      "weight": "600 900",
      "licence": "OFL-1.1",
      "copyright": "Copyright 2020 The JetBrains Mono Project Authors (https://github.com/JetBrains/JetBrainsMono)"
    },
    {
      "family": "pack-cyberspec-display",
      "source": "Kode Mono",
      "file": "kode-mono-600.woff2",
      "weight": "100 900",
      "licence": "OFL-1.1",
      "copyright": "Copyright 2023 The Kode Mono Project Authors (https://github.com/isaozler/kode-mono)"
    }
  ],
  "stage": {
    "layers": [
      {
        "fill": "#07070C"
      },
      {
        "image": "radar.svg",
        "animated": true,
        "minSizeClass": "md"
      }
    ],
    "effects": [
      {
        "kind": "scanlines",
        "cost": "static",
        "opacity": 0.1,
        "calm": "off"
      },
      {
        "kind": "vignette",
        "cost": "static",
        "opacity": 0.15,
        "calm": "off"
      }
    ],
    "grid": {
      "size": 22,
      "alpha": 0.2,
      "minSizeClass": "sm"
    },
    "chrome": {
      "cut": 48,
      "alpha": 0.55,
      "tab": {
        "width": 260,
        "height": 28,
        "text": "CYBERSPEC // DECK 07"
      },
      "reticles": true,
      "minSizeClass": "md"
    }
  },
  "burnIn": "needs-shift",
  "statusBar": {
    "edge": "top"
  },
  "frame": {
    "corners": "cut",
    "size": 18,
    "which": [
      "tr",
      "bl"
    ],
    "stroke": 1,
    "alpha": 0.55,
    "band": {
      "edge": "left",
      "width": 10
    },
    "tint": 0.05,
    "tone": "state",
    "grid": {
      "size": 22,
      "alpha": 0.22
    },
    "rule": true,
    "glow": {
      "radius": 10,
      "alpha": 0.3
    },
    "caption": {
      "text": "MB-RX // REV 3 // NODE 3F:A2",
      "at": "tl"
    },
    "tab": {
      "at": "tl",
      "width": 56,
      "height": 5,
      "out": true
    }
  },
  "ornaments": [
    {
      "kind": "reticle",
      "at": "tr",
      "minSizeClass": "md"
    },
    {
      "kind": "ticks",
      "at": "bottom",
      "minSizeClass": "md"
    }
  ],
  "motion": {
    "arrival": {
      "style": "clip"
    },
    "decode": {},
    "glitch": {
      "target": "all",
      "every": 24
    },
    "value": {
      "on": false,
      "style": "roll",
      "mark": "glitch",
      "every": 2
    },
    "list": {
      "enter": "slide",
      "decode": true
    },
    "boot": {
      "style": "glitch",
      "stagger": 60,
      "line": true,
      "decode": true
    },
    "flicker": {
      "on": false,
      "target": "label",
      "every": 12
    },
    "sweep": {
      "on": false
    },
    "art": {
      "on": false
    }
  },
  "script": {
    "file": "fx.js"
  }
}
