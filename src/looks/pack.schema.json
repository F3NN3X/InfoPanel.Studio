{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Pack",
  "description": "A theme pack's pack.json as built (_docs/look-system/03-theme-packs-spec.md, Pack format): the data the gallery, the loader and the validator read. Files are named relative to the pack's assets folder. `ornament`, `edge` and `assets` are optional declarations the validator checks (an ornament at most 10 px, a chamfer at most 20 px, the asset list against the files).",
  "type": "object",
  "required": ["id", "name", "version", "tags", "description", "modes", "fonts", "stage", "burnIn"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string" },
    "modes": { "type": "array", "minItems": 1, "items": { "enum": ["dark", "light"] } },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "file", "weight", "licence", "copyright"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string", "pattern": "^pack-[a-z0-9-]+$" },
          "source": { "type": "string" },
          "file": { "type": "string", "minLength": 1 },
          "weight": { "type": "string", "pattern": "^(normal|bold|[1-9]00( [1-9]00)?)$" },
          "style": { "enum": ["normal", "italic"] },
          "licence": { "type": "string" },
          "copyright": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["layers"],
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fill": { "type": "string" },
              "image": { "type": "string" },
              "opacity": { "type": "number" },
              "minSizeClass": { "enum": ["xs", "sm", "md", "lg"] },
              "animated": { "type": "boolean", "description": "The layer's SVG animates (its own CSS keyframes or SMIL, held to the validator's subset, rule svg-animation): drawn moving only at the Effects level Full, still otherwise." }
            }
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "cost"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["grain", "scanlines", "vignette", "glow", "blur", "glitch", "flicker", "rgb-split", "interference"] },
              "cost": { "enum": ["static", "composited", "filter", "mask", "animated"] },
              "opacity": { "type": "number" },
              "px": { "type": "number" },
              "fallback": { "enum": ["off", "static"] },
              "calm": { "enum": ["off", "static"] },
              "rate": { "type": "number" },
              "minSizeClass": { "enum": ["xs", "sm", "md", "lg"] }
            }
          }
        },
        "overlayMinSizeClass": { "enum": ["xs", "sm", "md", "lg"] }
      }
    },
    "burnIn": { "enum": ["static-safe", "needs-shift", "needs-dim"] },
    "statusBar": { "type": "object", "additionalProperties": false, "properties": { "edge": { "enum": ["top", "bottom"] } } },
    "connectors": {
      "type": "object",
      "required": ["style"],
      "additionalProperties": false,
      "properties": { "style": { "enum": ["line", "elbow"] }, "dot": { "type": "boolean" } }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "bytes"],
        "additionalProperties": false,
        "properties": { "file": { "type": "string", "minLength": 1 }, "bytes": { "type": "number", "minimum": 0 } }
      }
    },
    "frame": {
      "type": "object",
      "required": ["corners", "size"],
      "additionalProperties": false,
      "properties": {
        "corners": { "enum": ["square", "cut", "bracket", "notch"] },
        "size": { "type": "number", "minimum": 0, "maximum": 20 },
        "which": { "type": "array", "minItems": 1, "items": { "enum": ["tl", "tr", "br", "bl"] } },
        "stroke": { "type": "number", "minimum": 0, "maximum": 2 },
        "byCorner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tl": { "enum": ["square", "cut", "bracket", "notch"] },
            "tr": { "enum": ["square", "cut", "bracket", "notch"] },
            "br": { "enum": ["square", "cut", "bracket", "notch"] },
            "bl": { "enum": ["square", "cut", "bracket", "notch"] }
          }
        },
        "spine": {
          "type": "object",
          "required": ["edge", "width"],
          "additionalProperties": false,
          "properties": { "edge": { "enum": ["left", "right", "top", "bottom"] }, "width": { "type": "number", "minimum": 1, "maximum": 6 } }
        },
        "tab": {
          "type": "object",
          "required": ["at", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "at": { "enum": ["tl", "tr", "br", "bl"] },
            "width": { "type": "number", "minimum": 1, "maximum": 64 },
            "height": { "type": "number", "minimum": 1, "maximum": 8 }
          }
        },
        "double": { "type": "boolean" },
        "alpha": { "type": "number", "minimum": 0.2, "maximum": 1 }
      }
    },
    "ornaments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "at"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["micro-print", "ticks", "reticle", "label"] },
          "at": { "enum": ["tl", "tr", "br", "bl", "top", "bottom"] },
          "text": { "type": "string", "minLength": 1 },
          "minSizeClass": { "enum": ["xs", "sm", "md", "lg"] }
        }
      }
    },
    "motion": {
      "description": "Text and card effects the app draws (L117, src/looks/motion.ts): each effect's ranges are the validator's (rule motion).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "glitch": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "ms": { "type": "number" }, "every": { "type": "number" }, "target": { "enum": ["text", "value", "all"] } } },
        "decode": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "ms": { "type": "number" } } },
        "scramble": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "ms": { "type": "number" }, "every": { "type": "number" } } },
        "arrival": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "ms": { "type": "number" }, "style": { "enum": ["fade", "clip", "line"] } } },
        "flicker": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "every": { "type": "number" }, "target": { "enum": ["card", "label"] } } },
        "sweep": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "ms": { "type": "number" }, "every": { "type": "number" } } },
        "value": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "ms": { "type": "number" }, "every": { "type": "number" }, "style": { "enum": ["tween", "roll"] }, "mark": { "enum": ["none", "flash", "underline", "glitch"] } } },
        "list": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "ms": { "type": "number" }, "enter": { "enum": ["slide", "fade", "none"] }, "reorder": { "type": "boolean" }, "change": { "type": "boolean" }, "decode": { "type": "boolean" } } },
        "boot": { "type": "object", "additionalProperties": false, "properties": { "on": { "type": "boolean" }, "intensity": { "type": "number" }, "ms": { "type": "number" }, "stagger": { "type": "number" }, "style": { "enum": ["fade", "clip", "glitch"] }, "line": { "type": "boolean" }, "decode": { "type": "boolean" } } }
      }
    },
    "script": {
      "description": "The pack's one effect script, a .js file of its assets (listed in assets like any other, at most 64 KB), run only in the pack-script sandbox (src/looks/pack-script/) and only when the server says it runs.",
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": { "file": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}\\.js$" } }
    },
    "ornament": {
      "type": "object",
      "required": ["size"],
      "additionalProperties": false,
      "properties": { "size": { "type": "number", "minimum": 0 }, "bleed": { "type": "boolean" } }
    },
    "edge": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": { "kind": { "enum": ["none", "chamfer", "distressed"] }, "cut": { "type": "number", "minimum": 0 } }
    }
  }
}
