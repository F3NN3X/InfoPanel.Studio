{
  "name": "infopanel-studio",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "node server.mjs",
    "serve": "npm run build && node server.mjs",
    "desktop:prepare": "node tools/desktop-prepare.mjs",
    "desktop:web": "tsc -b && vite build --outDir .cache/desktop/dist --emptyOutDir",
    "desktop:dev": "npm run desktop:web && npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run desktop:web && npm run desktop:prepare && tauri build",
    "lab": "vite --config lab/infopanel/vite.config.ts",
    "lab:test": "vitest run --config lab/infopanel/vite.config.ts",
    "lab:typecheck": "tsc -p lab/infopanel",
    "lab:extract": "node lab/infopanel/scripts/extract-corpus.mjs",
    "lab:map": "node lab/infopanel/scripts/map-report.mjs",
    "lab:fonts": "node lab/infopanel/scripts/fonts.mjs",
    "lab:font-get": "node lab/infopanel/scripts/font-get.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  }
}
