{
  "name": "infopanel-studio",
  "private": true,
  "version": "1.3.0-beta.27",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:server": "node tools/parity/test-native.mjs",
    "test:e2e": "playwright test --project=e2e",
    "perf:kiosk": "playwright test --project=perf-kiosk --workers=1",
    "perf:studio": "playwright test --project=perf-studio --workers=1",
    "perf:all": "npm run build && npm run desktop:settings && playwright test --project=perf-kiosk --project=perf-studio --workers=1 && node tools/perf/bundle-report.mjs && node tools/perf/disk-report.mjs",
    "perf:compare": "node tools/perf/compare.mjs",
    "perf:budgets": "node tools/perf/check-budgets.mjs",
    "lint": "biome lint",
    "verify": "node tools/verify.mjs",
    "verify:full": "node tools/verify.mjs --full",
    "verify:plan": "node tools/verify.mjs --plan",
    "start": "node tools/start.mjs",
    "serve": "npm run build && node tools/start.mjs",
    "desktop:prepare": "node tools/desktop-prepare.mjs",
    "desktop:settings": "vite build --config vite.settings.config.ts",
    "desktop:web": "tsc -b && vite build --outDir .cache/desktop/dist --emptyOutDir && npm run desktop:settings",
    "desktop:dev": "npm run desktop:web && npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run desktop:web && npm run desktop:prepare && tauri build",
    "lab": "vite --config lab/infopanel/vite.config.ts",
    "lab:test": "vitest run --config lab/infopanel/vite.config.ts",
    "lab:typecheck": "tsc -p lab/infopanel",
    "lab:extract": "node lab/infopanel/scripts/extract-corpus.mjs",
    "lab:map": "node lab/infopanel/scripts/map-report.mjs",
    "lab:fonts": "node lab/infopanel/scripts/fonts.mjs",
    "lab:font-get": "node lab/infopanel/scripts/font-get.mjs",
    "audit:views": "vitest run --config tools/audit/vitest.config.ts",
    "build:stats": "vite build --mode stats"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "marked": "^18.1.1",
    "modern-screenshot": "4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  }
}
