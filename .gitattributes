# The schema tests parse these specs with 
-only patterns.
docs/redesign/widgets/**/*.md text eol=lf
# Vitest cannot parse a shebang line that ends in CR.
tools/*.mjs text eol=lf
# Vitest writes snapshots with LF; a CRLF checkout shows them modified after every run.
*.snap text eol=lf
# Tauri regenerates these on every build with LF; a CRLF checkout shows them modified.
src-tauri/permissions/autogenerated/*.toml text eol=lf
