{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's own pages (start.html, app/settings.html, app/help.html): settings, server control and agents. On the server's origin the studio and the settings window get their own sets at runtime (src/control.rs).",
  "windows": [
    "main",
    "settings",
    "help"
  ],
  "local": true,
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-set-setting",
    "allow-set-zoom",
    "allow-server-status",
    "allow-start-server",
    "allow-stop-server",
    "allow-restart-server",
    "allow-find-free-port",
    "allow-server-stats",
    "allow-use-foreign-server",
    "allow-foreign-server-info",
    "allow-open-studio",
    "allow-open-logs-folder",
    "allow-read-log-tail",
    "allow-read-log",
    "allow-reveal-path",
    "allow-get-diagnostics",
    "allow-set-agents",
    "allow-agents-status",
    "allow-repair-agents",
    "allow-open-agent-backups",
    "allow-open-devtools",
    "allow-list-local-addresses",
    "allow-quit-app",
    "allow-open-settings",
    "allow-open-help",
    "allow-get-debug",
    "allow-update-state",
    "allow-check-for-update",
    "allow-download-update",
    "allow-cancel-update",
    "allow-install-update",
    "allow-app-info",
    "allow-changelog",
    "allow-open-external",
    "allow-default-browser-kind",
    "allow-run-setup",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized"
  ]
}
