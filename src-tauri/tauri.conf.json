{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfoPanel Studio",
  "version": "../package.json",
  "identifier": "dev.f3nn3x.infopanel-studio",
  "build": {
    "frontendDist": "pages"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNjRFQUEzMUU3NTgwMzcKUldRM2dIVWVvK3BrRUlJT0JsaUJzM2FBTHVNK3E4elpISGJDb3lzTzlxUVJwL1lDbGY1elMyUE0K",
      "endpoints": ["https://github.com/F3NN3X/InfoPanel.Studio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "F3NN3X",
    "shortDescription": "InfoPanel Studio and its dashboard server",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/node/": "node/",
      "resources/app/": "app/",
      "../CHANGELOG.md": "CHANGELOG.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
