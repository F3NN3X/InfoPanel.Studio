      "summary": "The CI, nightly and release workflows, and the scripts they run (plan outputs, release gate, actionlint pin, desktop stub).",
      "paths": [".github/**", "tools/ci/**", "tools/ci-stub-desktop.mjs"],
      "tests": ["tests/tools/ci*.test.mjs"],
      "checks": ["unit", "actionlint"]
    },
    {
      "id": "import-lab",
      "summary": "The InfoPanel import lab (its own Vite and Vitest config).",
      "paths": ["lab/**"],
      "tests": [],
      "checks": ["lab", "import-check"]
    },
    {
      "id": "e2e-harness",
      "summary": "What the Playwright specs run on: the scratch server, the fake Data API, the perf fixture, the specs' shared fixtures.",
      "paths": [
        "playwright.config.ts",
        "tools/perf/scratch.mjs",
        "tools/perf/scratch.d.mts",
        "tools/perf/server-command.mjs",
        "tools/perf/fake-data-api.mjs",
        "tools/perf/make-fixture.mjs"
      ],
      "tests": ["tests/e2e/fixtures.ts", "tests/fixtures/perf/**"],
      "checks": ["typecheck", "e2e"]
    },
    {
      "id": "budgets",
      "summary": "The gating bundle budgets and the report that feeds them.",
      "paths": ["tools/perf/budgets.json", "tools/perf/check-budgets.mjs", "tools/perf/bundle-report.mjs"],
      "tests": [],
      "checks": ["build", "budgets"]
    },
    {
      "id": "perf",
      "summary": "Report-only perf and desktop specs, samplers and reports. They measure and never gate.",
      "paths": [
        "tools/perf/**",
        "tests/perf/**",
        "tests/desktop/**"
      ],
      "exclude": [
        "tools/perf/budgets.json",
        "tools/perf/check-budgets.mjs",
        "tools/perf/bundle-report.mjs",
        "tools/perf/scratch.mjs",
        "tools/perf/scratch.d.mts",
        "tools/perf/server-command.mjs",
        "tools/perf/fake-data-api.mjs",
        "tools/perf/make-fixture.mjs"
      ],
      "tests": [],
      "checks": ["typecheck"],
      "report": ["npm run perf:kiosk", "npm run perf:studio", "npm run perf:compare"],
      "note": "Never a gating check: run them by hand (docs/performance.md)."
    },
    {
      "id": "dev-tools",
      "summary": "Audits and asset generators.",
      "paths": ["tools/audit/**", "tools/gen-bg.mjs", "tools/vendor-meteocons.mjs"],
      "tests": [],
      "checks": [],
      "report": ["npm run audit:views"]
    },
    {
      "id": "public-assets",
      "summary": "Static files served as-is.",
      "paths": ["public/**"],
      "tests": [],
      "checks": ["build"]
    },
    {
      "id": "tooling",
      "summary": "Dependencies, compiler, bundler, linter, test setup and verify itself: anything here can break everything.",
      "paths": [
        "package.json",
        "package-lock.json",
        "tsconfig.json",
        "vite.config.ts",
        "biome.json",
        "tests/setup/**",
        "tests/feature-map.json",
        "tools/verify.mjs",
        "tools/verify/**",
        ".githooks/**",
        ".gitignore",
        ".gitattributes"
      ],
      "tests": ["tests/feature-map.test.ts", "tests/tools/verify*.test.mjs", "tests/tools/stop-hook.test.mjs"],
      "checks": ["full"]
    },
    {
      "id": "docs",
      "fallback": true,
      "summary": "Prose docs with no test reading them.",
      "paths": ["docs/**", "README.md"],
      "tests": [],
      "checks": [],
      "note": "Lowest priority: a path matched by another feature takes that feature's checks instead."
    }
  ]
}
