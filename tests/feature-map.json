{
  "$comment": "Feature -> test map for InfoPanel Studio. Every tracked source file must match at least one feature's `paths`; every file under tests/ must match a feature's `tests` (or `paths`, for harness files). tools/verify.mjs reads this file; tests/feature-map.test.ts keeps it honest. Globs are relative to the repo root; `**` skips dotfiles, so list those by name. Order of `checks` is the order verify runs them in. A check marked `always` (lint) runs on every change without being listed per feature.",
  "version": 1,
  "checks": {
    "lint": {
      "cmd": "npx biome lint --no-errors-on-unmatched {files}",
      "fullCmd": "npx biome ci",
      "files": ["src/**/*.{ts,tsx,css}", "tests/**/*.{ts,tsx,mjs}", "tools/**/*.{mjs,cjs,ts,tsx}", "lab/infopanel/**/*.{ts,tsx}", "*.{mjs,ts}"],
      "always": true,
      "when": "every change, the changed files Biome covers (skipped when there are none)"
    },
    "actionlint": { "cmd": "node tools/ci/actionlint.mjs", "when": "workflow files: actionlint, a pinned release checked by SHA-256" },
    "typecheck": { "cmd": "npx tsc -b", "when": "any TypeScript change (src/ and tests/ share one project)" },
    "unit": {
      "cmd": "npx vitest related --run --passWithNoTests {tests}",
      "fullCmd": "npx vitest run",
      "fastCmd": "npx vitest run --passWithNoTests {tests}",
      "tests": ["tests/**/*.test.*"],
      "testsExclude": ["tests/server/**"],
      "related": true,
      "when": "the feature's Vitest files plus the tests that import a changed source file"
    },
    "build": { "cmd": "npm run build", "when": "entry points, Vite config, public assets, dependencies" },
    "budgets": { "cmd": "npm run perf:budgets", "needs": ["build"], "when": "the gzip and request budgets (tools/perf/budgets.json); gating" },
    "settings-build": { "cmd": "npm run desktop:settings", "when": "the Settings window's own entry" },
    "server-bin": { "cmd": "cargo build -p ips-server", "cwd": "src-tauri", "when": "the debug ips-server the e2e specs start" },
    "server-suite": {
      "cmd": "npm run test:server -- {tests}",
      "fullCmd": "npm run test:server",
      "tests": ["tests/server/**/*.test.*"],
      "emptyMeansAll": true,
      "when": "the HTTP suite in tests/server, run against the built ips-server"
    },
    "lab": { "cmd": "npm run lab:typecheck && npm run lab:test", "when": "the import lab or the InfoPanel parsers it shares" },
    "import-check": {
      "cmd": "node lab/infopanel/scripts/import-check.mts",
      "platform": "win32",
      "notRunExit": 3,
      "when": "the .infopanel writer: our exports read by InfoPanel's own XmlSerializer (.NET, an InfoPanel source folder), compared field by field. Exit 3 where .NET or the source is missing"
    },
    "e2e": {
      "cmd": "npx playwright test --project=e2e {tests}",
      "fullCmd": "npm run test:e2e",
      "tests": ["tests/e2e/*.spec.ts"],
      "emptyMeansAll": true,
      "needs": ["build", "server-bin"],
      "when": "the Playwright specs: real browser, real server, scratch data"
    },
    "cargo-server": {
      "cmd": "cargo test -p ips-server -p ips-agent && cargo clippy -p ips-server -p ips-agent --all-targets -- -D warnings",
      "cwd": "src-tauri",
      "when": "the dashboard server and the agent hooks (runs on every platform); includes the parity tests over tests/fixtures/parity"
    },
    "stub-desktop": { "cmd": "node tools/ci-stub-desktop.mjs", "platform": "win32", "when": "creates src-tauri/resources only where it is missing (a clean CI runner); needs the built ips-agent" },
    "cargo-app": {
      "needs": ["stub-desktop"],
      "cmd": "cargo test && cargo clippy --workspace --all-targets -- -D warnings",
      "cwd": "src-tauri",
      "platform": "win32",
      "when": "the Tauri app crate (WebView2 crates: Windows only); needs src-tauri/resources in place"
    },
    "full": { "escalate": true, "when": "tooling or dependency changes that can affect everything: runs every check above" }
  },
